# Local development settings. Copy to .env and adjust.
# Production uses .env.production (see .env.production.example).
# Never put long-lived AWS access keys in this file.
APP_NAME=AI Log Analyzer

# AWS (only needed for CloudWatch ingestion or Bedrock)
AWS_PROFILE=log-analyzer
AWS_REGION=us-east-1
# Optional: custom endpoint for CloudWatch Logs (e.g. LocalStack: http://localhost:4566)
AWS_ENDPOINT_URL=

# AI provider: hybrid (Ollama, then Bedrock) | ollama | bedrock | none
# Local default is Ollama only, so local testing never incurs Bedrock charges.
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Input limits and safety
MAX_LOG_BYTES=2000000
MAX_LINES=10000
REDACT_SECRETS=true
