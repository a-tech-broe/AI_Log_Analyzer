# Production settings. Copy to .env.production and adjust.
# Run with: ENV_FILE=.env.production docker compose up -d
# Never put long-lived AWS access keys in this file; use a task role or instance profile.
APP_NAME=AI Log Analyzer

# Leave AWS_PROFILE empty to use the default credential chain (task role / instance profile).
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=

# Ollama first, Amazon Bedrock fallback if Ollama is down or returns an unusable response.
AI_PROVIDER=hybrid
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Input limits and safety
MAX_LOG_BYTES=2000000
MAX_LINES=10000
REDACT_SECRETS=true
